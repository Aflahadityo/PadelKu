generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  PLAYER
  VENUE_OWNER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingSlotStatus {
  AVAILABLE
  BOOKED
  LOCKED
  CANCELLED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  VA
  EWALLET
  QRIS
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  SUCCESS
  EXPIRED
  DENY
  CANCEL
  FAILURE
  REFUND
  CHARGEBACK
  PARTIAL_REFUND
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?
  password  String
  role      Role     @default(PLAYER)
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  venues        Venue[]
  bookings      Booking[]
  reviews       Review[]
  notifications Notification[]
  lockedSlots   BookingSlot[] @relation("SlotLock")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Venue {
  id             String         @id @default(cuid())
  name           String
  description    String?
  address        String
  city           String
  latitude       Float?
  longitude      Float?
  phone          String?
  email          String?
  images         String[]
  facilities     String[]
  openingTime    String         @default("08:00")
  closingTime    String         @default("22:00")
  approvalStatus ApprovalStatus @default(PENDING)
  ownerId        String
  owner          User           @relation(fields: [ownerId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  courts   Court[]
  bookings Booking[]
  reviews  Review[]

  @@index([ownerId])
  @@index([city])
  @@index([approvalStatus])
  @@map("venues")
}

model Court {
  id           String   @id @default(cuid())
  name         String
  courtNumber  Int
  pricePerHour Decimal  @db.Decimal(10, 2)
  isActive     Boolean  @default(true)
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookingSlots BookingSlot[]

  @@unique([venueId, courtNumber])
  @@index([venueId])
  @@map("courts")
}

model BookingSlot {
  id            String            @id @default(cuid())
  date          DateTime
  startTime     String            // "08:00"
  endTime       String            // "09:00"
  status        BookingSlotStatus @default(AVAILABLE)
  price         Decimal           @db.Decimal(10, 2)
  lockedAt      DateTime?
  lockedById    String?
  lockedBy      User?             @relation("SlotLock", fields: [lockedById], references: [id])
  lockExpiresAt DateTime?
  courtId       String
  court         Court             @relation(fields: [courtId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  bookings BookingSlotBooking[]

  @@unique([courtId, date, startTime, endTime])
  @@index([courtId])
  @@index([date])
  @@index([status])
  @@index([lockedById])
  @@index([lockExpiresAt])
  @@map("booking_slots")
}

model Booking {
  id         String        @id @default(cuid())
  totalPrice Decimal       @db.Decimal(10, 2)
  status     BookingStatus @default(PENDING_PAYMENT)
  orderId    String?       @unique
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  venueId    String
  venue      Venue         @relation(fields: [venueId], references: [id])
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  slots    BookingSlotBooking[]
  payments Payment[]
  review   Review?

  @@index([userId])
  @@index([venueId])
  @@index([status])
  @@index([orderId])
  @@map("bookings")
}

model BookingSlotBooking {
  bookingId     String
  booking       Booking     @relation(fields: [bookingId], references: [id])
  bookingSlotId String
  bookingSlot   BookingSlot @relation(fields: [bookingSlotId], references: [id])

  @@id([bookingId, bookingSlotId])
  @@index([bookingSlotId])
  @@map("booking_slot_bookings")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  paymentMethod PaymentMethod
  transactionId String?       @unique
  grossAmount   Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([bookingId])
  @@index([transactionId])
  @@map("payments")
}

model Review {
  id        String   @id @default(cuid())
  rating    Int
  comment   String?
  bookingId String   @unique
  booking   Booking  @relation(fields: [bookingId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([venueId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  title     String
  message   String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
