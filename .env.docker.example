# Reference only. Do not pass this file to Docker Compose.
# Bootstrap writes the real environment to ignored .supabase/docker/.env.
# POSIX: sh infra/supabase/bootstrap.sh
# Windows: powershell -ExecutionPolicy Bypass -File infra/supabase/bootstrap.ps1

SUPABASE_SNAPSHOT=self-hosted/v0.8.0
SUPABASE_PUBLIC_URL=http://supabase.localhost:8000
API_EXTERNAL_URL=http://supabase.localhost:8000/auth/v1
SITE_URL=http://localhost:3000
APP_PORT=3000
POSTGRES_DIRECT_PORT=54322

# These values must come from the official generator scripts used by bootstrap.
POSTGRES_PASSWORD=<generated-by-utils-generate-keys-sh>
JWT_SECRET=<generated-by-utils-generate-keys-sh>
SUPABASE_PUBLISHABLE_KEY=<generated-by-utils-add-new-auth-keys-sh>
SUPABASE_SECRET_KEY=<generated-by-utils-add-new-auth-keys-sh>
MAINTENANCE_SECRET=<generated-64-character-hex-secret>
